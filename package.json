{
  "name": "memelens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "memelens": "node --disable-warning=ExperimentalWarning --import tsx packages/data/src/bin.ts",
    "typecheck:all": "tsc -p packages/core --noEmit && tsc -p packages/data --noEmit && tsc -p packages/service --noEmit && tsc -p apps/desktop --noEmit && tsc -p apps/desktop/src/renderer --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
